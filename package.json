{
  "name": "upp",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Static status page for HagiCode sites, backed by scheduled GitHub Actions checks.",
  "dependencies": {
    "@hagicode/hagilight": "0.20.0",
    "@hagicode/hagilight-core": "0.20.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "fflate": "0.8.3",
    "sharp": "^0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "astro": "^7.4.0"
  },
  "scripts": {
    "build": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\"; astro build",
    "dev": "astro dev",
    "monitor": "node scripts/monitor/run.mjs",
    "release-check": "node scripts/release-hash/run.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check:registry": "node scripts/check-registry-neutrality.mjs",
    "test:registry": "node --test scripts/check-registry-neutrality.node-test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
