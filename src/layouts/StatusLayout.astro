---
import SEOHead from '@hagicode/hagilight/SEOHead';
import Footer from '@hagicode/hagilight/Footer';
import { resolveFaviconHeadEntry } from '@hagicode/hagilight-core/favicon';
import sharedFaviconUrl from '@hagicode/hagilight-core/favicon.ico';
import '../styles/status.css';

interface Props {
  title: string;
  description: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;

// hagilightFavicon() only edits Astro's config head, which this layout does not render. The shared
// icon is therefore supplied here, through SEOHead, so the page links it.
const faviconEntry = resolveFaviconHeadEntry([], { href: sharedFaviconUrl });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead page={{ title, description }} head={faviconEntry ? [faviconEntry] : []} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to service status</a>
    <main id="main" class:list={["status-main", { "status-main--wall": wide }]} tabindex="-1">
      <slot />
    </main>
    <Footer locale="en-US" />
  </body>
</html>
