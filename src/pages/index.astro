---
import StatusLayout from '../layouts/StatusLayout.astro';
import StatusSummary from '../components/status/StatusSummary.astro';
import ServiceStatus from '../components/status/ServiceStatus.astro';
import { loadStatusData } from '../lib/load-status.mjs';
import { summarizeOverall } from '../lib/status.mjs';

const { snapshot, source } = await loadStatusData();
const summary = summarizeOverall(snapshot);
const title = 'Service status';
const description = 'Observed availability of HagiCode sites, with the time of each last check.';
---

<StatusLayout title={title} description={description}>
  <h1 class="page-title">{title}</h1>
  <StatusSummary snapshot={snapshot} summary={summary} source={source} />
  <section class="services-section" aria-labelledby="services-heading">
    <h2 id="services-heading">Services</h2>
    {snapshot.sites.length === 0 ? (
      <p>No sites configured.</p>
    ) : (
      <ol class="services">
        {snapshot.sites.map((site) => (
          <li>
            <ServiceStatus site={site} generatedAt={snapshot.generatedAt} />
          </li>
        ))}
      </ol>
    )}
  </section>
  <p class="machine-readable">
    Machine-readable snapshot: <a href={`${import.meta.env.BASE_URL}status.json`}>status.json</a>
  </p>
  <script>
    import '../scripts/status-freshness.js';
  </script>
</StatusLayout>
